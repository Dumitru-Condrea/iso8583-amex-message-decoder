public static <E extends Enum<E>> E getEnum(
        ResultSet rs,
        String column,
        Class<E> enumClass
) throws SQLException {

    String value = rs.getString(column);

    if (value == null) {
        return null;
    }

    return Enum.valueOf(
            enumClass,
            value.trim().toUpperCase(Locale.ROOT)
    );
}
