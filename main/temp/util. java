public static byte[] getBlobBytes(
        ResultSet resultSet,
        String columnName) throws SQLException {

    Blob blob = resultSet.getBlob(columnName);

    if (blob == null) {
        return null;
    }

    try {
        return blob.getBytes(
                1,
                Math.toIntExact(blob.length())
        );
    } finally {
        blob.free();
    }
}
