
@And("I have made a delete token request for {wsTokenType}")
public void iHaveMadeATokenWebServiceDeleteRequest(
        TokenWebServiceHelper.TokenType type) {

    final int maxAttempts = 3;

    for (int attempt = 1; attempt <= maxAttempts; attempt++) {
        try {
            TokenWebServiceUtil.deleteTokens(testData, type);
            return;

        } catch (Exception exception) {
            log.error("Token deletion failed. Attempt {}/{}",
                    attempt, maxAttempts, exception);

            if (attempt == maxAttempts) {
                throw new TestException(
                        exception.getMessage(), exception);
            }

            GeneralUtilities.waitFor(20L * attempt);
        }
    }
}
