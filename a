@DataTableType
public TestData transform(DataTable table) {

    Map<String, String> values = new LinkedHashMap<>();

    for (List<String> row : table.cells()) {

        if (row.size() != 2) {
            throw new IllegalArgumentException(
                    "Expected exactly two columns in TestData table"
            );
        }

        values.put(row.get(0), row.get(1));
    }

    boolean createNew = Boolean.parseBoolean(
            values.remove(NEW_INSTANCE_KEY)
    );

    TestData target = createNew
            ? ReflectionUtil.copy(testData)
            : testData;

    return ReflectionUtil.apply(
            target,
            values
    );
}
