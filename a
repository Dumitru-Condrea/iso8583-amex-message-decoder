import io.cucumber.datatable.DataTable;
import io.cucumber.java.DataTableType;

import java.util.LinkedHashMap;
import java.util.Map;

public class TestDataTableTransformers {

    private static final String NEW_INSTANCE_KEY = "__new__";

    private TestData testData;

    @DataTableType
    public TestData transform(DataTable table) {

        Map<String, String> values = new LinkedHashMap<>(
                table.asMap(String.class, String.class)
        );

        boolean createNew = Boolean.parseBoolean(
                values.remove(NEW_INSTANCE_KEY)
        );

        TestData target = createNew
                ? ReflectionUtil.copy(testData)
                : testData;

        return ReflectionUtil.apply(target, values);
    }
}
