public static void checkTokenResponseErrorStatus(
        boolean shouldContainErrors,
        String expectedError
) {
    List<TokenError> errors = lastTokenResponse.getErrors();

    if (!shouldContainErrors) {
        assertThat(errors)
                .as("No token errors were expected. Response: %s",
                        printUsefulTokenDetails(lastTokenResponse))
                .isEmpty();

        log.info("No token errors reported, as expected.");
        return;
    }

    assertThat(errors)
            .as("Token response was expected to contain errors. Response: %s",
                    printUsefulTokenDetails(lastTokenResponse))
            .isNotEmpty();

    if (expectedError != null && !expectedError.isEmpty()) {
        assertThat(errors)
                .extracting(TokenError::getMessage)
                .as("Expected token error: %s", expectedError)
                .contains(expectedError);
    }

    log.info("Token errors validated successfully: {}",
            printUsefulTokenDetails(lastTokenResponse));
}
