final int maxAttempts = 3;

for (int attempt = 1; ; attempt++) {
    try {
        TokenWebServiceUtil.deleteTokens(testData, type);
        return;

    } catch (Exception exception) {
        log.error("Token deletion failed. Attempt {}/{}",
                attempt, maxAttempts, exception);

        if (attempt >= maxAttempts) {
            throw new TestException(exception.getMessage(), exception);
        }

        GeneralUtilities.waitFor(20L * attempt);
    }
}
